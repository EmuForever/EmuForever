<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\default.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BattleNot</RootNamespace>
    <AssemblyName>BattleNot</AssemblyName>
    <ApplicationIcon>bnot.ico</ApplicationIcon>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Framework\Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Configs/BattleNot.conf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CreateLogsFolder" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir)Logs" />
  </Target>

</Project>
