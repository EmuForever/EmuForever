<Project Sdk="Microsoft.NET.Sdk">
  
  <Import Project="..\..\default.props" />
  
  <PropertyGroup>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.1" />
    <PackageReference Include="MySqlConnector" Version="2.5.0" />
  </ItemGroup>

  <!-- Prebuilt native Detour runtime (x64); consumed by the managed P/Invoke wrapper. -->
  <ItemGroup>
    <None Include="..\Native\bin\DetourNative.dll" Link="DetourNative.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\Native\bin\DetourNative.LICENSE.txt" Link="DetourNative.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  
</Project>
